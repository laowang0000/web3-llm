# Ollama local runtime
# qwen3.5:9b is the recommended default local chat model for stability.
# qwen3.6:latest and larger installed models can still be selected from the React Model Settings page.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Keep nomic-embed-text fixed for RAG consistency unless you intentionally rebuild the Chroma index.
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_CHAT_TIMEOUT_SECONDS=60
OLLAMA_EMBED_BATCH_SIZE=8
OLLAMA_NUM_PREDICT=160
OLLAMA_THINK=false
EMBEDDING_PROVIDER=ollama
RAG_INDEX_BATCH_SIZE=32
# Smart Context Selection uses this as the default RAG retrieval limit.
# This does not disable RAG; it limits default context size unless the query requires document context.
RAG_TOP_K=3

# Optional FastAPI runtime
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000

# Public read-only market data endpoints
BINANCE_BASE_URL=https://api.binance.com
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1
COINPAPRIKA_API_KEY=
MARKET_PROVIDER_ORDER=binance,coingecko,coinpaprika
MARKET_REQUEST_TIMEOUT=10
MARKET_TIMEOUT_SECONDS=4

# Optional DeFi ecosystem context for /analyze
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_REQUEST_TIMEOUT=10
ENABLE_DEFILLAMA_CONTEXT=true

# Optional live news augmentation for /news and /analyze
MARKETAUX_BASE_URL=https://api.marketaux.com/v1
MARKETAUX_API_TOKEN=
GNEWS_BASE_URL=https://gnews.io/api/v4
GNEWS_API_KEY=
NEWS_TIMEOUT_SECONDS=4
# Smart Context Selection uses this as the default live-news article limit.
# This does not disable news; it limits prompt size unless the query requires news context.
NEWS_MAX_ARTICLES=3
